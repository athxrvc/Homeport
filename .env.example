# Copy to .env (scripts/start.* does this for you and generates a key).
# .env is git-ignored. Never commit it.

# Required. Every request to the gateway must send this as a Bearer token.
# Generate one with:  python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=

# Optional: only for `-Tunnel named` / `--tunnel named`.
# Token from the Cloudflare Zero Trust dashboard (Networks > Tunnels > your tunnel).
# If unset, cloudflared/config.yml is used instead.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: the hostname you mapped to the tunnel, so the start script can print
# a ready-to-paste URL, e.g. https://llm.example.com
PUBLIC_URL=
